[Unit]
Description=MSU schedule Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/raspisanie
ExecStart=/opt/raspisanie/.venv/bin/python /opt/raspisanie/main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
